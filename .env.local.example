# Netrin 前端 → 自托管 Supabase 的连接配置（模板）
#
# 用法：把本文件复制为同目录下的 .env.local，填入真实值。
#   - .env.local 已被 git 忽略，不会进仓库；
#   - Claude 不会读取 .env.local；代码只通过 import.meta.env 引用下面的变量名。
#
# 从你自己的 Supabase 项目设置中取得公开 anon/publishable key。
# 不要把服务端高权限 key、数据库密码或服务器路径写入前端环境变量。

VITE_SUPABASE_URL=https://supabase.example.com
VITE_SUPABASE_ANON_KEY=

# 高德 JS API 2.0（前端 Web key）
# 真实值只写入 .env.local；不要提交 key 或 securityJsCode。
# VITE_AMAP_SERVICE_HOST 用于生产代理安全密钥方案，留空则不启用。
# VITE_AMAP_SECURITY_JSCODE 仅限本地开发临时验证；生产不要把它暴露到前端。
VITE_AMAP_KEY=
VITE_AMAP_SERVICE_HOST=https://app.example.com/_AMapService
VITE_AMAP_SECURITY_JSCODE=

# AI 路线默认使用同源 `/v1/ai-route/*`；留空不会关闭 AI。
# 仅在浏览器必须直连另一个 Origin 时填写公开根地址。模型 API Key 只能由用户在单次请求中输入，
# 不得出现在任何 VITE_ 环境变量中。Provider 选项由运行时能力响应决定。
# `npm run dev` / `npm run preview` 默认代理到确定性本地 mock；如需联调真实服务，
# 只在当前命令进程设置非 VITE_ 的 NETRIN_AI_ROUTE_PROXY_TARGET，不要把密钥或目标写入仓库。
VITE_AI_ROUTE_API_BASE=

# 阿里云 PNVS AccessKey、签名、模板和 Send SMS Hook Secret 只放服务器端
# 的秘密存储中，绝不能加入此文件或使用 VITE_ 前缀。
