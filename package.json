{
  "name": "netrin-cell",
  "private": true,
  "version": "0.1.2",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MagicSpirit007/Netrin.git"
  },
  "homepage": "https://utopians.cloud/netrin/",
  "bugs": {
    "url": "https://github.com/MagicSpirit007/Netrin/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/local-ai-vite.mjs dev",
    "dev:raw": "vite",
    "build": "tsc --noEmit && node scripts/vite-production-build.mjs && node scripts/check-performance-budget.mjs && node scripts/scan-build-secrets.mjs",
    "release:static": "node scripts/prepare-static-release.mjs",
    "preview": "node scripts/local-ai-vite.mjs preview",
    "preview:raw": "vite preview",
    "test": "vitest run",
    "test:smoke": "node scripts/browser-smoke.mjs",
    "test:appearance-workbench": "node scripts/appearance-workbench-smoke.mjs",
    "test:appearance-flow": "vitest run src/appearance/reviewReport.test.ts src/appearance/accessGate.test.ts src/appearance/reviewGateCore.test.ts src/appearance/workbenchFlow.test.ts src/appearance/catalog.test.ts src/appearance/appearanceFlow.integration.test.ts src/data/adminSections.test.ts",
    "test:appearance-lifecycle": "vitest run scripts/appearance-lifecycle.test.ts scripts/appearance-dev-lifecycle.test.ts",
    "test:appearance-e2e": "node scripts/appearance-e2e.mjs",
    "shell:check": "node scripts/check-shell-files.mjs",
    "validate:appearance": "node scripts/validate-appearance.mjs",
    "typecheck": "tsc --noEmit",
    "validate:cell": "node scripts/validate-cell.mjs",
    "lint": "biome lint .",
    "licenses:check": "node scripts/check-third-party-licenses.mjs",
    "dco:check": "node scripts/check-dco.mjs",
    "scan:dist": "node scripts/scan-build-secrets.mjs",
    "quality:budget": "node scripts/check-performance-budget.mjs",
    "knowledge:amap": "node scripts/generate-amap-knowledge.mjs",
    "knowledge:amap:check": "node scripts/generate-amap-knowledge.mjs --check --check-links",
    "appearance:init": "tsx scripts/appearance-init.ts",
    "appearance:dev": "tsx scripts/appearance-dev.ts",
    "appearance:check": "tsx scripts/appearance-check.ts",
    "appearance:validate": "tsx scripts/appearance-validate.ts",
    "appearance:package": "tsx scripts/appearance-package.ts",
    "appearance:review": "tsx scripts/appearance-review.ts",
    "ai:typecheck": "npm --prefix services/netrin-ai-orchestrator run typecheck",
    "ai:test": "npm --prefix services/netrin-ai-orchestrator run test",
    "ai:build": "npm --prefix services/netrin-ai-orchestrator run build"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "@supabase/supabase-js": "^2.115.0",
    "@turf/distance": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/nearest-point-on-line": "^7.4.0",
    "@turf/simplify": "^7.4.0",
    "fflate": "^0.8.3",
    "i18next": "^26.4.2",
    "localforage": "^1.10.0",
    "mammoth": "^1.12.2",
    "pdfjs-dist": "^6.3.289",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^7.1.6",
    "postcss-value-parser": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "standardwebhooks": "1.1.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
