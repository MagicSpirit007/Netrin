[Unit]
Description=Netrin AI dedicated Docker egress firewall
Requires=docker.service
After=docker.service
PartOf=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/netrin-ai-egress-firewall
ExecReload=/usr/local/sbin/netrin-ai-egress-firewall
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
